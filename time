<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>العد التنازلي · الأسواق المالية</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(145deg, #0b0e14 0%, #1a1f2a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', 'Tahoma', 'system-ui', sans-serif;
            padding: 1rem;
        }

        .card {
            background: #1e2532;
            background-image: radial-gradient(circle at 20% 30%, #2c3545 0%, #141a24 90%);
            border-radius: 3rem 3rem 2.5rem 2.5rem;
            padding: 2.5rem 3rem 2.8rem;
            box-shadow: 
                0 20px 40px rgba(0, 0, 0, 0.7),
                inset 0 2px 3px rgba(255, 255, 255, 0.06),
                inset 0 -3px 6px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 215, 120, 0.15);
            backdrop-filter: blur(2px);
            max-width: 700px;
            width: 100%;
        }

        .market-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px solid rgba(212, 175, 55, 0.25);
            padding-bottom: 0.6rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .market-title {
            font-size: 1.7rem;
            font-weight: 500;
            letter-spacing: 2px;
            color: #f5e7c8;
            text-shadow: 0 2px 5px rgba(0,0,0,0.6);
        }

        .market-title span {
            font-weight: 300;
            color: #c9b27c;
            margin-right: 6px;
        }

        .hijri-display {
            font-size: 1rem;
            color: #b9aa83;
            background: rgba(0,0,0,0.3);
            padding: 0.2rem 1rem;
            border-radius: 30px;
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        /* حقل إدخال التاريخ */
        .input-section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 1.8rem;
            background: rgba(0, 0, 0, 0.2);
            padding: 1.5rem;
            border-radius: 1.5rem;
            border: 1px solid rgba(255, 215, 120, 0.1);
        }

        .input-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .input-row label {
            color: #d6c9ad;
            font-size: 1.1rem;
            font-weight: 400;
        }

        .input-row input {
            padding: 0.6rem 1rem;
            border-radius: 40px;
            border: 1px solid rgba(212, 175, 55, 0.3);
            background: rgba(0, 0, 0, 0.4);
            color: #f2e3c2;
            font-size: 1rem;
            direction: ltr;
            text-align: center;
            flex: 1;
            min-width: 150px;
        }

        .input-row input:focus {
            outline: none;
            border-color: #f5d742;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
        }

        .btn-start {
            padding: 0.6rem 2.5rem;
            border-radius: 40px;
            border: none;
            background: linear-gradient(145deg, #f5d742, #c9a832);
            color: #1a1f2a;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }

        .btn-start:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 25px rgba(212, 175, 55, 0.5);
        }

        .btn-start:active {
            transform: scale(0.95);
        }

        /* الوقت المتبقي */
        .time-block {
            display: flex;
            justify-content: center;
            align-items: baseline;
            gap: 0.25rem;
            margin-top: 0.2rem;
            margin-bottom: 0.5rem;
            direction: ltr;
            flex-wrap: wrap;
        }

        .time-digits {
            font-size: 4rem;
            font-weight: 600;
            color: #f2e3c2;
            letter-spacing: 4px;
            text-shadow: 0 0 12px rgba(212, 175, 55, 0.3), 0 4px 8px rgba(0,0,0,0.7);
            background: rgba(0, 0, 0, 0.25);
            padding: 0.1rem 1rem;
            border-radius: 60px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 215, 120, 0.15);
            font-variant-numeric: tabular-nums;
            line-height: 1.3;
            min-width: 80px;
            text-align: center;
        }

        .time-label {
            font-size: 1.2rem;
            color: #b9aa83;
            margin: 0 0.3rem;
        }

        .bottom-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.8rem;
            padding-top: 0.8rem;
            border-top: 1px solid rgba(212, 175, 55, 0.15);
            flex-wrap: wrap;
            gap: 0.8rem 1rem;
        }

        .target-date {
            font-size: 1.1rem;
            color: #d6c9ad;
            background: rgba(0, 0, 0, 0.2);
            padding: 0.2rem 1.5rem;
            border-radius: 40px;
            border: 1px solid rgba(255, 215, 120, 0.1);
        }

        .status-message {
            font-size: 1.2rem;
            font-weight: 300;
            color: #e7dbb8;
            background: rgba(0, 0, 0, 0.2);
            padding: 0 1.2rem;
            border-radius: 50px;
            border: 1px solid rgba(212, 175, 55, 0.2);
            line-height: 1.6;
        }

        @media (max-width: 600px) {
            .card {
                padding: 1.5rem 1rem 1.8rem;
                border-radius: 2rem;
            }
            .market-title {
                font-size: 1.3rem;
            }
            .time-digits {
                font-size: 2.8rem;
                padding: 0.1rem 0.6rem;
                min-width: 60px;
            }
            .time-label {
                font-size: 1rem;
            }
            .input-row {
                flex-direction: column;
            }
            .input-row input {
                width: 100%;
                min-width: unset;
            }
        }
    </style>
</head>
<body>
    <div class="card">
        <!-- رأس البطاقة -->
        <div class="market-header">
            <div class="market-title">
                <span>⏳</span> العد التنازلي
            </div>
            <div class="hijri-display" id="hijriDate">1448 محرم 4</div>
        </div>

        <!-- حقل إدخال التاريخ والوقت -->
        <div class="input-section">
            <div class="input-row">
                <label for="targetDateTime">📅 اختر الموعد:</label>
                <input type="datetime-local" id="targetDateTime">
                <button class="btn-start" id="startBtn">▶ ابدأ العد</button>
            </div>
        </div>

        <!-- العد التنازلي -->
        <div class="time-block">
            <span class="time-digits" id="days">00</span>
            <span class="time-label">يوم</span>
            <span class="time-digits" id="hours">00</span>
            <span class="time-label">ساعة</span>
            <span class="time-digits" id="minutes">00</span>
            <span class="time-label">دقيقة</span>
            <span class="time-digits" id="seconds">00</span>
            <span class="time-label">ثانية</span>
        </div>

        <!-- الصف السفلي -->
        <div class="bottom-row">
            <span class="target-date" id="targetDisplay">⏰ لم يتم تحديد موعد</span>
            <span class="status-message" id="statusMessage">✋ انتظر التحديد</span>
        </div>
    </div>

    <!-- مكتبات moment و moment-hijri -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment-hijri/2.1.0/moment-hijri.min.js"></script>

    <script>
        (function() {
            // عناصر DOM
            const daysEl = document.getElementById('days');
            const hoursEl = document.getElementById('hours');
            const minutesEl = document.getElementById('minutes');
            const secondsEl = document.getElementById('seconds');
            const targetDisplay = document.getElementById('targetDisplay');
            const statusMessage = document.getElementById('statusMessage');
            const hijriDateEl = document.getElementById('hijriDate');
            const targetInput = document.getElementById('targetDateTime');
            const startBtn = document.getElementById('startBtn');

            let targetDate = null; // تاريخ الهدف
            let countdownInterval = null; // معرف الـ interval

            // تحديث التاريخ الهجري
            function updateHijri() {
                const hijri = moment().format('iYYYY iMMMM iDD');
                hijriDateEl.textContent = hijri;
            }
            updateHijri();

            // دالة العد التنازلي
            function updateCountdown() {
                if (!targetDate) {
                    // لو مفيش تاريخ محدد، نعرض أصفار
                    daysEl.textContent = '00';
                    hoursEl.textContent = '00';
                    minutesEl.textContent = '00';
                    secondsEl.textContent = '00';
                    return;
                }

                const now = new Date().getTime();
                const distance = targetDate.getTime() - now;

                if (distance < 0) {
                    // الوقت خلص
                    daysEl.textContent = '00';
                    hoursEl.textContent = '00';
                    minutesEl.textContent = '00';
                    secondsEl.textContent = '00';
                    statusMessage.textContent = '✅ انتهى الوقت!';
                    statusMessage.style.color = '#7ddf9a';
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                    return;
                }

                // حساب الأيام والساعات والدقائق والثواني
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                // عرض القيم مع صفرين
                daysEl.textContent = String(days).padStart(2, '0');
                hoursEl.textContent = String(hours).padStart(2, '0');
                minutesEl.textContent = String(minutes).padStart(2, '0');
                secondsEl.textContent = String(seconds).padStart(2, '0');

                statusMessage.textContent = '⏳ جاري العد...';
                statusMessage.style.color = '#e7dbb8';
            }

            // بدء العد التنازلي
            function startCountdown() {
                const inputValue = targetInput.value;
                if (!inputValue) {
                    alert('⚠️ من فضلك اختر تاريخ ووقت أولاً!');
                    return;
                }

                // تحويل الإدخال إلى Date
                const selectedDate = new Date(inputValue);
                if (isNaN(selectedDate.getTime())) {
                    alert('⚠️ التاريخ غير صحيح!');
                    return;
                }

                const now = new Date();
                if (selectedDate <= now) {
                    alert('⚠️ التاريخ يجب أن يكون في المستقبل!');
                    return;
                }

                // حفظ التاريخ الهدف
                targetDate = selectedDate;

                // عرض التاريخ الهدف بشكل جميل
                const options = { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                };
                targetDisplay.textContent = `🎯 ${selectedDate.toLocaleDateString('ar-EG', options)}`;

                // لو في Interval قديم، نلغيه
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                }

                // نبدأ Interval جديد
                updateCountdown(); // تحديث فوري
                countdownInterval = setInterval(updateCountdown, 1000);
            }

            // ربط الزر
            startBtn.addEventListener('click', startCountdown);

            // دعم Enter في حقل الإدخال
            targetInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    startCountdown();
                }
            });

            // تعيين قيمة افتراضية (بعد 7 أيام من الآن)
            function setDefaultTarget() {
                const now = new Date();
                const future = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
                const year = future.getFullYear();
                const month = String(future.getMonth() + 1).padStart(2, '0');
                const day = String(future.getDate()).padStart(2, '0');
                const hours = String(future.getHours()).padStart(2, '0');
                const minutes = String(future.getMinutes()).padStart(2, '0');
                targetInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
            }
            setDefaultTarget();

            // تحديث التاريخ الهجري كل دقيقة
            setInterval(updateHijri, 60000);
        })();
    </script>
</body>
</html>
